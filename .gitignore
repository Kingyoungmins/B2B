# PyInstaller build artifacts
build/
# 자동 생성된 exe 버전 리소스(tools/gen_version_meta.py 산출물)
build_meta/
dist/
*.spec.bak

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# OS / IDE
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Zone.Identifier (Windows download metadata)
*Zone.Identifier

# Local automatic skill backups
auto_backups/
auto_backup/

# Runner file-output results
output/

# Local runtime/debug logs
vba_pipeline_trace.jsonl
runtime_load_trace.jsonl
vba_runner_fail.log
*_log.txt
# 빌드 스크립트가 남기는 로그(bn_a/bn_b/bv_a/bv_b 등) — 커밋 대상 아님
b[nv]_[ab].log

# Regression test generated reports
tests/vba_regression/reports/**
!tests/vba_regression/reports/.gitkeep
tests/vba_regression/cases/_orig_backup/

# Local transfer packages
dist_transfer/

# Native host generated files
native_host/bin/
native_host/packages/

# Embed prototype build output
embed_proto/bin/
_tmp_*

# [0.5.13 신규 repo] 루트 스킬-export zip(테스트 산출물), 단일 exe 산출물
/*.zip

# [0.5.18] 로컬 eval 게이트 스크래치 — Qwen 엔드포인트/API키 포함, 절대 커밋 금지
test_runs/_qwen_client.py
test_runs/_prompt_*.txt
test_runs/_batch_*.txt
test_runs/_batch_*.log
test_runs/_flagged_dump.txt
tools/issue_recheck/results_history.jsonl
tools/issue_recheck/registry.json.bak
keys.local.json

# [axcell_runner 배포 번들] dist/ 는 위에서 통째로 무시하지만, ixi-flow 설치용 번들
# tar.gz 는 브랜치에서 바로 내려받을 수 있어야 하므로 예외로 추적한다(_staging 등은 계속 무시).
!tools/axcell_runner_mcp/dist/
tools/axcell_runner_mcp/dist/*
!tools/axcell_runner_mcp/dist/*.tar.gz
