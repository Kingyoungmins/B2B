# .env 예시 — 이 파일을 `.env` 로 복사해서 실제 값을 채운다.
# `.env` 는 .gitignore 되어 있다. 절대 커밋하지 마라.
#
# 여기 값이 없어도 버전 확인·로그 수집은 정상 동작한다.
# 문서보안(DRM) 중계(drm.py)를 쓸 때만 필요하다.

# ── MIP Gateway (문서보안) ────────────────────────────────────────────────
# 게이트웨이 주소. 비워 두면 코드의 기본값(운영)을 쓴다.
MIP_GATEWAY_BASE_URL=
# 발급받은 API 키 (필수)
MIP_API_KEY=

# 게이트웨이 이름이 안 풀리는 폐쇄망(파드)에서 대신 붙을 IP.
# 비워 두면 코드 기본값(운영 VIP). URL 호스트명은 그대로라 TLS 검증은 정상.
MIP_GATEWAY_IP=

# [규격 v0.3 필수] 게이트웨이에 보낼 '업무시스템 IP'.
# NAT/컨테이너 뒤라면 반드시 Outbound NAT IP(게이트웨이가 보는 IP)를 넣는다.
# API 키 발급 때 등록한 IP 와 같아야 한다 — 다르면 -100 오류가 나고,
# 그 오류 메시지에 게이트웨이가 본 IP 가 함께 오므로 그 값을 그대로 넣으면 된다.
MIP_CLIENT_IP=

# requestorAccount 는 '사용자의 마당 ID'(윈도우 계정명과 다를 수 있음).
# 클라이언트가 계정을 못 보냈을 때 쓸 예비값.
MIP_REQUESTOR_ACCOUNT=

# 요청 제한시간(초). 비우면 기본값.
MIP_TIMEOUT=60

# 처리 허용 최대 파일 크기(MB). 비우면 기본 200.
MIP_MAX_FILE_MB=

# 구형 VIP/보안장비가 TLS 1.3 을 그냥 끊는(RST) 경우에만 1.2 로 고정한다.
# 비워 두면 자동 — 켤 때 1.3 이 끊기는지 확인하고 끊기면 알아서 1.2 로 보낸다.
MIP_TLS_MAX=

# ── 로그 수집 API 인증 (선택) ─────────────────────────────────────────────
# 비워 두면 인증 없이 받는다(사내망 전제). 값을 넣으면 그 키를 요구한다.
# 업로드용: 앱이 X-B2B-Log-Key 헤더로 보낸다.
AXCELL_LOG_INGEST_KEY=
# 관리 조회용: /v1/admin/* 에 key= 또는 X-Admin-Key 로 요구한다.
AXCELL_LOG_ADMIN_KEY=

# ── 버전 안내 (선택) ──────────────────────────────────────────────────────
# 앱의 "다운로드 하러가기" 가 열 주소. --download-url 인자로도 줄 수 있다.
AXCELL_DOWNLOAD_URL=
