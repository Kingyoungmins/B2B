-def read_cron_file(folder):
-    """cron.txt 에서 (식, 주석줄들) 을 뽑는다."""
-    path = folder / "cron.txt"
-    if not path.is_file():
-        return "", []
-    try:
-        lines = path.read_text(encoding="utf-8").splitlines()
-    except OSError:
-        return "", []
-    expr, comments = "", []
-    for line in lines:
-        t = line.strip()
-        if t.startswith("#"):
-            comments.append(t)
-        elif t and not expr:
-            expr = t
-    return expr, comments
