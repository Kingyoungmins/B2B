-def parse_cron_expr(expr):
-    """crontab 5필드 → 화면이 쓰는 스케줄 dict. 못 읽으면 None.
-
-    cron.txt 가 '무엇이 언제 도는지'의 유일한 근거다. schedule.json 이 없는
-    옛 폴더도 이걸로 읽어야 수정 화면을 채울 수 있다.
-    """
-    parts = str(expr or "").split()
-    if len(parts) != 5:
-        return None
-    minute, hour, dom, mon, dow = parts
-    try:
-        tm = "%02d:%02d" % (int(hour), int(minute))
-    except ValueError:
-        return None
-
-    out = {"time": tm, "day": 1, "weekday": 1, "date": ""}
-    if dom != "*" and mon != "*":
-        out["cycle"] = "once"
-        try:
-            out["day"] = int(dom)
-            out["month"] = int(mon)
-        except ValueError:
-            return None
-    elif dom != "*":
-        out["cycle"] = "monthly"
-        try:
-            out["day"] = int(dom)
-        except ValueError:
-            return None
-    elif dow != "*":
-        out["cycle"] = "weekly"
-        try:
-            out["weekday"] = int(dow) % 7
-        except ValueError:
-            return None
-    else:
-        out["cycle"] = "daily"
-    return out
-
